Host *
    AddKeysToAgent yes
    UseKeychain yes

# Default Github 
Host github.com
    HostName github.com
    User git
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/id_rsa
    IdentitiesOnly yes

# Deloitte Github
Host deloitte.github.com
    HostName github.com
    User git
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/id_rsa_danipan-deloitte
    IdentitiesOnly yes
# p32h Github
Host p32h.github.com
    HostName github.com
    User git
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/id_ed25519_p32h
    IdentitiesOnly yes
